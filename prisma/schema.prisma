// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  TRAINER
  CLIENT
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  Trainer   Trainer?
  Client    Client?
}

model Trainer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  hourlyFix Int
  active    Boolean  @default(true)
  slots     Slot[]
  clients   Client[] // ← opačná strana Client.trainer
}

model Client {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  rate      Int
  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id])
  slots     Slot[]
  // ⛔ ŽÁDNÉ pole typu Client? ani clientId zde nemá být
}

model Slot {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  trainerId   String
  trainer     Trainer  @relation(fields: [trainerId], references: [id])
  weekday     Int
  startMin    Int
  durationMin Int
  active      Boolean  @default(true)
  lessons     Lesson[]
}

enum LessonType {
  CONTRACT
  EXTRA
}

enum LessonState {
  PLANNED
  TAUGHT
  EXCUSED
  NO_SHOW
  REPLACEMENT
}

model Lesson {
  id     String      @id @default(uuid())
  slotId String
  slot   Slot        @relation(fields: [slotId], references: [id])
  date   DateTime
  state  LessonState @default(PLANNED)
  type   LessonType  @default(CONTRACT)
}
